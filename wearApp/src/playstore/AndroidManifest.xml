<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="com.gcaguilar.biciradar.wear.WearMonitoringSessionsService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bizi/monitoring-sessions" />
            </intent-filter>
        </service>
        <service
            android:name="com.gcaguilar.biciradar.wear.WearFavoritesSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bizi/favorites" />
            </intent-filter>
        </service>
    </application>
</manifest>
