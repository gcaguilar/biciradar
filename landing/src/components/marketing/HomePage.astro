---
import type { LocaleContent } from '../../content/marketing/types';
import type { CityKey } from '../../content/marketing/types';
import FaqList from './FaqList.astro';
import PageHeader from './PageHeader.astro';
import PhoneShot from './PhoneShot.astro';
import SiteFooter from './SiteFooter.astro';
import StoreButtons from './StoreButtons.astro';
import AnalyticsScripts from './AnalyticsScripts.astro';
import Icon from '../Icon.astro';
import { appStoreUrlForLocale, playStoreUrlForLocale } from '../../lib/site-config';

interface LanguageLink {
  href: string;
  label: string;
  localeLabel: string;
  current: boolean;
}

interface CityLink {
  key: CityKey;
  href: string;
  label: string;
}

interface Props {
  content: LocaleContent;
  languageLinks: LanguageLink[];
  homeHref: string;
  cityLinks: CityLink[];
}

const { content, languageLinks, homeHref, cityLinks } = Astro.props;
const { home } = content;
const appStoreHref = appStoreUrlForLocale(content.locale);
const playStoreHref = playStoreUrlForLocale(content.locale);
const [benefitsId, showcaseId, howId, citiesId, faqId] = home.header.sections.map((item) => item.id);
const cityHrefByKey = new Map(cityLinks.map((item) => [item.key, item.href]));
const featuredKeys = new Set(home.cities.items.map((city) => city.key));
const otherCities = cityLinks.filter((city) => !featuredKeys.has(city.key));
const webMcpConfig = {
  locale: content.locale,
  homeHref,
  downloadSectionSelector: '#descargar',
  appStoreHref,
  playStoreHref,
  cityLinks: cityLinks.map((city) => ({
    key: city.key,
    href: city.href,
  })),
};
---

<PageHeader
  siteName={content.metadata.siteName}
  homeHref={homeHref}
  languageLabel={home.header.languageLabel}
  languageLinks={languageLinks}
  navLinks={home.header.sections.map((item) => ({ href: `#${item.id}`, label: item.label }))}
  primaryCtaLabel={home.header.primaryCta}
  primaryCtaHref="#descargar"
  appStoreHref={appStoreHref}
  playStoreHref={playStoreHref}
  primaryEvent="hero_cta_click"
  githubAriaLabel={content.common.githubAriaLabel}
/>

<main id="main-content">
  <section class="marketing-shell marketing-hero" aria-labelledby="hero-title">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-12">
      <div class="space-y-6">
        <div class="space-y-4">
          <h1 id="hero-title" class="max-w-3xl text-balance text-4xl font-black leading-[1.05] tracking-tight text-slate-950 sm:text-5xl lg:text-6xl">
            {home.hero.title}
          </h1>
          <p class="max-w-xl text-lg leading-8 text-slate-600">
            {home.hero.description}
          </p>
        </div>

        <div class="space-y-3" data-hero-cta>
          <StoreButtons
            appStoreHref={appStoreHref}
            playStoreHref={playStoreHref}
            appStoreLabel={home.hero.primaryCta}
            playStoreLabel={home.hero.secondaryCta}
            placement="hero"
          />
          <p class="text-sm font-medium text-slate-600">{home.hero.microcopy}</p>
        </div>

        <ul class="flex flex-wrap gap-2" aria-label={home.hero.microcopy}>
          {home.hero.trust.map((item) => (
            <li class="marketing-value-pill">
              <Icon name="check" class="mr-1.5 size-3.5 text-emerald-700" />
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="hero-phone">
        <PhoneShot shot="map" alt={home.hero.screenshotAlt} priority sizes="(min-width: 1024px) 320px, 70vw" />
      </div>
    </div>
  </section>

  <section class="marketing-shell" id={benefitsId} aria-labelledby="benefits-title">
    <div class="max-w-3xl space-y-3">
      <h2 id="benefits-title" class="marketing-section-title">{home.solution.title}</h2>
      <p class="text-base leading-7 text-slate-600">{home.solution.intro}</p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {home.solution.cards.map((card) => (
        <article class="marketing-card">
          {card.icon && (
            <span class="marketing-card-icon">
              <Icon name={card.icon} class="size-5" />
            </span>
          )}
          <h3 class="marketing-card-title">{card.title}</h3>
          <p class="marketing-card-copy">{card.description}</p>
        </article>
      ))}
    </div>

    <p class="mt-6 flex items-start gap-2 text-sm leading-6 text-slate-600">
      <Icon name="check" class="mt-1 size-4 shrink-0 text-emerald-700" />
      <span>{home.solution.note}</span>
    </p>
  </section>

  <section class="marketing-shell" id={showcaseId} aria-labelledby="showcase-title">
    <div class="max-w-3xl space-y-3">
      <h2 id="showcase-title" class="marketing-section-title">{home.showcase.title}</h2>
      <p class="text-base leading-7 text-slate-600">{home.showcase.intro}</p>
    </div>

    <ul class="showcase-track no-scrollbar mt-8">
      {home.showcase.items.map((item) => (
        <li class="showcase-item">
          <PhoneShot shot={item.key} alt={item.alt} sizes="(min-width: 1024px) 260px, 70vw" />
          <h3 class="marketing-card-title mt-4">{item.title}</h3>
          <p class="marketing-card-copy">{item.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="marketing-shell" id={howId} aria-labelledby="how-title">
    <div class="space-y-3">
      <h2 id="how-title" class="marketing-section-title">{home.howItWorks.title}</h2>
    </div>

    <ol class="mt-8 grid gap-4 lg:grid-cols-3">
      {home.howItWorks.steps.map((step) => (
        <li class="marketing-step-card">
          <span class="marketing-step-number">{step.number}</span>
          <h3 class="marketing-card-title">{step.title}</h3>
          <p class="marketing-card-copy">{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="marketing-shell" id={citiesId} aria-labelledby="cities-title">
    <div class="space-y-3">
      <h2 id="cities-title" class="marketing-section-title">{home.cities.title}</h2>
      <p class="max-w-3xl text-base leading-7 text-slate-600">{home.cities.description}</p>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {home.cities.items.map((city) => (
        <a
          class="marketing-city-card"
          href={cityHrefByKey.get(city.key)}
          data-track-event="city_page_click"
          data-track-city={city.name}
          data-track-system={city.system}
        >
          <div class="space-y-2">
            <p class="text-sm font-semibold text-sky-700">{city.name} · {city.system}</p>
            <h3 class="marketing-card-title">{city.description}</h3>
          </div>
          <span class="text-sm font-semibold text-slate-950">{content.common.cityPageCta}</span>
        </a>
      ))}
    </div>

    {otherCities.length > 0 && (
      <div class="mt-6">
        <p class="text-sm font-semibold text-slate-700">{home.cities.otherCitiesLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {otherCities.map((city) => (
            <li>
              <a
                class="inline-flex min-h-10 items-center rounded-full border border-slate-300 bg-white px-3.5 py-1.5 text-sm font-medium text-slate-700 transition hover:border-slate-900 hover:text-slate-950"
                href={city.href}
                data-track-event="city_page_click"
                data-track-city={city.label}
              >
                {city.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <p class="mt-4 text-sm text-slate-600">{home.cities.moreLabel}</p>
  </section>

  <section class="marketing-shell" id={faqId} aria-labelledby="faq-title">
    <div class="space-y-3">
      <h2 id="faq-title" class="marketing-section-title">{home.faq.title}</h2>
    </div>

    <div class="mt-8">
      <FaqList items={home.faq.items} />
    </div>
  </section>

  <section class="marketing-shell" id="descargar" aria-labelledby="download-title" data-final-cta>
    <div class="marketing-dark-band">
      <div class="space-y-3">
        <h2 id="download-title" class="text-3xl font-black tracking-tight text-white sm:text-4xl">{home.midCta.title}</h2>
        <p class="max-w-2xl text-base leading-7 text-slate-300">{home.midCta.description}</p>
      </div>

      <div class="mt-6 space-y-3">
        <StoreButtons
          appStoreHref={appStoreHref}
          playStoreHref={playStoreHref}
          appStoreLabel={home.midCta.primaryCta.label}
          playStoreLabel={home.midCta.secondaryCta.label}
          placement="final_cta"
        />
        <p class="text-sm font-medium text-slate-300">{home.midCta.reassurance}</p>
      </div>
    </div>
  </section>

  <SiteFooter
    siteName={content.metadata.siteName}
    tagline={home.footer.tagline}
    links={home.footer.links}
    note={home.footer.note}
    betaLabel={home.footer.primaryCta}
    betaHref="#descargar"
    languageLabel={home.header.languageLabel}
    languageLinks={languageLinks}
    githubLine={home.footer.githubLine}
  />
</main>

<div class="marketing-sticky-bar md:hidden" data-sticky-bar data-hidden="true">
  <StoreButtons
    appStoreHref={appStoreHref}
    playStoreHref={playStoreHref}
    appStoreLabel={home.hero.primaryCta}
    playStoreLabel={home.hero.secondaryCta}
    placement="sticky_mobile"
    layout="bar"
  />
</div>

<script is:inline>
  (() => {
    const bar = document.querySelector('[data-sticky-bar]');
    const watched = [document.querySelector('[data-hero-cta]'), document.querySelector('[data-final-cta]')].filter(Boolean);
    if (!bar || watched.length === 0 || !('IntersectionObserver' in window)) {
      bar?.setAttribute('data-hidden', 'false');
      return;
    }

    const visible = new Set();
    const sync = () => bar.setAttribute('data-hidden', visible.size > 0 ? 'true' : 'false');
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      sync();
    });
    watched.forEach((el) => observer.observe(el));
    sync();
  })();
</script>

<AnalyticsScripts locale={content.locale} pageKind="home" />

<script is:inline define:vars={{ webMcpConfig }}>
  (() => {
    const config = webMcpConfig;
    const modelContext = typeof navigator !== 'undefined' ? navigator.modelContext : undefined;

    if (!modelContext) {
      return;
    }

    const cityHrefByKey = Object.fromEntries(
      config.cityLinks.map((city) => [city.key, new URL(city.href, window.location.origin).toString()]),
    );

    const tools = [
      {
        name: 'biciradar.get_page_context',
        description: 'Return the current BiciRadar landing-page context, including locale and store links.',
        inputSchema: {
          type: 'object',
          additionalProperties: false,
          properties: {},
        },
        execute: async () => ({
          locale: config.locale,
          homeUrl: new URL(config.homeHref, window.location.origin).toString(),
          storeLinks: {
            ios: config.appStoreHref,
            android: config.playStoreHref,
          },
        }),
      },
      {
        name: 'biciradar.list_supported_cities',
        description: 'List the city landing pages currently linked from the homepage.',
        inputSchema: {
          type: 'object',
          additionalProperties: false,
          properties: {},
        },
        execute: async () => ({
          cities: config.cityLinks.map((city) => ({
            key: city.key,
            url: cityHrefByKey[city.key],
          })),
        }),
      },
      {
        name: 'biciradar.open_city_page',
        description: 'Navigate to a BiciRadar city landing page.',
        inputSchema: {
          type: 'object',
          additionalProperties: false,
          required: ['cityKey'],
          properties: {
            cityKey: {
              type: 'string',
              enum: config.cityLinks.map((city) => city.key),
            },
          },
        },
        execute: async ({ cityKey }) => {
          const targetUrl = cityHrefByKey[cityKey];
          if (!targetUrl) {
            throw new Error(`Unsupported city key: ${cityKey}`);
          }

          window.location.assign(targetUrl);
          return { ok: true, navigatedTo: targetUrl };
        },
      },
      {
        name: 'biciradar.focus_beta_signup',
        description: 'Scroll to the download section and optionally focus a platform link.',
        inputSchema: {
          type: 'object',
          additionalProperties: false,
          properties: {
            operatingSystem: {
              type: 'string',
              enum: ['ios', 'android', 'both'],
            },
          },
        },
        execute: async ({ operatingSystem } = {}) => {
          const section = document.querySelector(config.downloadSectionSelector);
          if (!(section instanceof HTMLElement)) {
            throw new Error('Download section not found.');
          }

          section.scrollIntoView({ behavior: 'smooth', block: 'start' });

          const targetLink =
            operatingSystem === 'android'
              ? section.querySelector('[data-track-store="play_store"]')
              : section.querySelector('[data-track-store="app_store"]');

          if (targetLink instanceof HTMLAnchorElement) {
            targetLink.focus({ preventScroll: true });
          }

          return { ok: true, focused: true };
        },
      },
      {
        name: 'biciradar.open_store_listing',
        description: 'Open the BiciRadar App Store or Google Play listing.',
        inputSchema: {
          type: 'object',
          additionalProperties: false,
          required: ['platform'],
          properties: {
            platform: {
              type: 'string',
              enum: ['ios', 'android'],
            },
          },
        },
        execute: async ({ platform }) => {
          const targetUrl = platform === 'ios' ? config.appStoreHref : config.playStoreHref;
          window.location.assign(targetUrl);
          return { ok: true, navigatedTo: targetUrl };
        },
      },
    ];

    const registerTools = async () => {
      try {
        if (typeof modelContext.provideContext === 'function') {
          try {
            await modelContext.provideContext({ tools });
            return;
          } catch {
            // Fall through to the per-tool compatibility path.
          }
        }

        if (typeof modelContext.registerTool === 'function') {
          for (const tool of tools) {
            try {
              await modelContext.registerTool(tool);
            } catch {
              await modelContext.registerTool(
                tool.name,
                {
                  description: tool.description,
                  inputSchema: tool.inputSchema,
                },
                tool.execute,
              );
            }
          }
        }
      } catch (error) {
        console.error('WebMCP registration failed', error);
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          void registerTools();
        },
        { once: true },
      );
      return;
    }

    void registerTools();
  })();
</script>
