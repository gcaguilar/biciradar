---
import Layout from '../../layouts/Layout.astro';
import CityPage from '../../components/marketing/CityPage.astro';
import { getLocaleContent, locales, orderedCityKeys, type Locale } from '../../content/marketing';
import { buildAlternateLinks } from '../../lib/seo';
import { getLanguageSwitchLinks } from '../../lib/marketing-pages';
import { cityDefinitions } from '../../content/marketing/cities';
import type { FaqItemContent } from '../../content/marketing/types';
import { defaultLocale } from '../../lib/i18n';
import { getHomePath, resolveRouteContext } from '../../lib/routes';
import { getCityPageMessaging } from '../../lib/city-page-messaging';
import { absolutePageUrl, resolveSiteUrl } from '../../utils/site';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .flatMap((locale) =>
      orderedCityKeys.flatMap((cityKey) => {
        const city = cityDefinitions[cityKey];
        return [
          { params: { locale, slug: city.slug }, props: { locale, slug: city.slug } },
          ...(city.legacySlugs ?? []).map((legacySlug) => ({
            params: { locale, slug: legacySlug },
            props: { locale, slug: legacySlug },
          })),
        ];
      }),
    );
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const route = resolveRouteContext(locale, slug);

if (!route || route.kind !== 'city') {
  throw new Error(`Unknown localized route for "${locale}/${slug}"`);
}

const content = getLocaleContent(locale);
const site = resolveSiteUrl(Astro.site);
const alternates = buildAlternateLinks(route, site, import.meta.env.BASE_URL);
const homeHref = getHomePath(locale);
const cityKey = route.cityKey;
const canonicalSlug = cityDefinitions[cityKey].slug;
const isLegacySlug = slug !== canonicalSlug;
const betaHref = '#beta-form';

const pageContent = content.cityPages[cityKey];
const cityMessaging = getCityPageMessaging(locale, cityKey, pageContent);
const pageTitle = `${cityMessaging.seoTitle} | ${content.common.citySeoTitleSuffix}`;
const pageDescription = `${cityMessaging.seoDescription} ${content.common.citySeoDescriptionSuffix}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: pageTitle,
    description: pageDescription,
    inLanguage: locale,
    url: absolutePageUrl(`/${locale}/${canonicalSlug}/`, site, import.meta.env.BASE_URL),
    isPartOf: { '@type': 'WebSite', name: content.metadata.siteName, url: absolutePageUrl(`/${locale}/`, site, import.meta.env.BASE_URL) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: content.metadata.siteName, item: absolutePageUrl(`/${locale}/`, site, import.meta.env.BASE_URL) },
      { '@type': 'ListItem', position: 2, name: cityMessaging.title, item: absolutePageUrl(`/${locale}/${canonicalSlug}/`, site, import.meta.env.BASE_URL) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.cityPages[cityKey].faq.map((item: FaqItemContent) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  lang={locale}
  canonicalPath={`/${locale}/${canonicalSlug}/`}
  alternates={alternates}
  skipLinkLabel={content.common.skipToContent}
  robots={isLegacySlug ? 'noindex,follow' : 'index,follow'}
  redirectTo={isLegacySlug ? absolutePageUrl(`/${locale}/${canonicalSlug}/`, site, import.meta.env.BASE_URL) : undefined}
  structuredData={structuredData}
>
  <CityPage
    content={content}
    cityKey={cityKey}
    languageLinks={getLanguageSwitchLinks(route)}
    homeHref={homeHref}
    betaHref={betaHref}
  />
</Layout>
