// Fallback vacío: se define ANTES del include para que LocalSecrets.xcconfig
// (con la clave real) tenga la última palabra. Antes estaba después del include
// y borraba la clave: el simulador se quedaba con GOOGLE_MAPS_IOS_API_KEY vacío,
// GoogleMapsBootstrap.provideAPIKey no se llamaba, y el GMSMapView arrancaba sin
// tiles → mapa en blanco / render loop atascado en el arranque.
GOOGLE_MAPS_IOS_API_KEY =

// Configuración del backend/Auth0 de iOS. Los valores reales van en
// LocalSecrets.xcconfig (ignorado por git). OJO: en xcconfig `//` inicia un
// comentario, así que para una URL usa el truco `https:/$()/host` o define
// BICI_BACKEND_URL como variable de entorno del scheme en Debug.
BICI_BACKEND_URL =
BICI_AUTH0_DOMAIN =
BICI_AUTH0_CLIENT_ID =
BICI_AUTH0_AUDIENCE =
BICI_AUTH0_SCHEME = biciradar

#include? "LocalSecrets.xcconfig"
